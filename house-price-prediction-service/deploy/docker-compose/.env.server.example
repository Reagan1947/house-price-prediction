# 复制为 .env.server 后填写真实值（.env.server 已被 git 忽略）
# Env: dev、pro
ENVIRONMENT='dev'
# MySQL
DATABASE_HOST='your_mysql_host'
DATABASE_PORT=3306
DATABASE_USER='root'
DATABASE_PASSWORD='your_mysql_password'
# Redis
REDIS_HOST='your_redis_host'
REDIS_PORT=6379
REDIS_PASSWORD='your_redis_password'
REDIS_DATABASE=0
# Token
TOKEN_SECRET_KEY='your_jwt_secret'
# Model artifacts
MODEL_ARTIFACTS_DIR='model-artifacts'
